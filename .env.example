# ══════════════════════════════════════════════════════════════════════════════
# AI Finance Controller — Environment Configuration Example
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env before starting docker-compose or running the FastAPI app.

# ── Database Configuration ───────────────────────────────────────────────────
# Application role password (used by FastAPI / backend)
FINANCE_APP_PASSWORD=replace_with_a_secure_finance_app_password
# Superuser / migration owner password
POSTGRES_PASSWORD=replace_with_a_secure_postgres_password

# ── Supabase Authentication (Server-Side Only) ────────────────────────────────
# URL of your Supabase instance (e.g. https://your-project.supabase.co)
SUPABASE_URL=https://your-project.supabase.co
# Supabase Service Role Secret Key (NEVER expose to frontend clients)
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
# Supabase JWT Secret (used for verifying incoming Bearer tokens)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
# Supabase JWKS URL (optional alternative for public key rotation)
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# ── Feature Knobs & Scheduler ─────────────────────────────────────────────────
# Seed mock dataset endpoint (set to true only for local dev/testing)
ENABLE_SEED_ENDPOINT=true
# Automated background reconciliation job frequency
SCHEDULER_INTERVAL_MINUTES=30
