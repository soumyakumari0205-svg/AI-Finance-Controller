# ── Database ──────────────────────────────────────────────────────────────────
# For docker-compose local dev, this is set automatically.
# For production (Cloud Run / Railway), point at your Supabase Postgres:
DATABASE_URL=postgresql+asyncpg://finance:finance@localhost:5432/finance_controller

# ── Supabase (server-side ONLY — never expose these to the browser) ───────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# JWT verification — use ONE of the following:
# Option A: JWKS (recommended for production with real Supabase)
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/jwks
# Option B: Shared secret (local dev without a real Supabase project)
SUPABASE_JWT_SECRET=dev-secret-change-me

# ── Feature flags ─────────────────────────────────────────────────────────────
# NEVER set to true in production — this enables the /api/seed endpoint
ENABLE_SEED_ENDPOINT=true

# ── Scheduler ─────────────────────────────────────────────────────────────────
SCHEDULER_INTERVAL_MINUTES=30

# ── Reconciliation engine ─────────────────────────────────────────────────────
DATE_WINDOW_DAYS=3
FUZZY_THRESHOLD=0.70
DUPLICATE_TIE_THRESHOLD=0.80

# ── Anomaly detection ─────────────────────────────────────────────────────────
FEE_VARIANCE_THRESHOLD=0.03
DUPLICATE_WINDOW_HOURS=24

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
